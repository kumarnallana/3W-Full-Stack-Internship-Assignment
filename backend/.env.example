NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mini_social
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# Optional: configure Cloudinary for durable production image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use lax for same-site deployments. Use none only with HTTPS and separate sites.
COOKIE_SAME_SITE=lax
